[Unit]
Description=WinGo Automated Lottery Sync & Bet Settlement Daemon
After=network.target mysql.service mariadb.service
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/wingoapi
ExecStart=/usr/bin/php /var/www/wingoapi/cron/sync_worker.php --daemon --sleep=5
Restart=always
RestartSec=5
StandardOutput=append:/var/log/wingo_worker.log
StandardError=append:/var/log/wingo_worker_error.log

[Install]
WantedBy=multi-user.target
