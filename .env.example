# ==========================================================================
#  Lottery SaaS API — environment configuration
#  Copy to .env and fill in real values.  NEVER commit .env.
# ==========================================================================

APP_NAME="Lottery SaaS API"
APP_ENV=production          # production | staging | local
APP_DEBUG=false             # true leaks exception messages — keep false in prod
API_DOMAIN=api.example.com
TIMEZONE=Asia/Kolkata

# --------------------------------------------------------------- database
DB_TYPE=mysql               # mysql (production) | sqlite (local dev only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lottery
DB_USER=lottery
DB_PASS=change-me
DB_CHARSET=utf8mb4
DB_TIMEOUT=5
ALLOW_SQLITE_FALLBACK=false # true = silently fall back to SQLite if MySQL is down (dev only)
SQLITE_FILE=./data/lottery.sqlite

# ------------------------------------------------------------------- draw
# Provider endpoint template -> {base}/{game}/{interval}.json
#   e.g. https://draw.yourdomain.com/WinGo/WinGo_1M.json
DRAW_BASE_URL=https://draw.yourdomain.com
DRAW_URL_TEMPLATE={base}/{game}/{interval}.json
DRAW_TIMEOUT=5              # seconds; after this the local generator takes over
FORCE_REMOTE_DRAW=false     # true = never fall back to the local generator
DRAW_SECRET=change-me-64-random-chars   # HMAC-SHA256 key for local draws

# ---------------------------------------------------------------- betting
BET_MIN_STAKE=1
BET_MAX_STAKE=1000000
PAYOUT_TAX_RATE=0.02        # 2% tax on gross winnings

# -------------------------------------------------------------------- vip
VIP_EXP_PER_RUPEE=1

# ------------------------------------------------------------------- auth
JWT_SECRET=change-me-64-random-chars
JWT_TTL=86400
JWT_LEEWAY=30
SIGNATURE_SECRET=change-me-64-random-chars
REQUIRE_SIGNATURE=false     # true = write endpoints must carry signature+timestamp
SIGNATURE_TTL=300

# --------------------------------------------------------------- security
CORS_ORIGINS=*              # comma separated origins, or * for public read APIs
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_STORE=/dev/shm/lottery-rl
TRUSTED_PROXIES=            # comma separated proxy IPs allowed to set X-Forwarded-For
ADMIN_TOKEN=                # machine access to admin endpoints (X-Admin-Token header)

# ----------------------------------------------------------- admin panel
# Web console at https://your.domain/admin
ADMIN_PANEL_ENABLED=true
ADMIN_USER=admin
ADMIN_PASSWORD=             # panel login password (falls back to ADMIN_TOKEN)
ADMIN_SESSION_TTL=28800     # 8 hours

# ---------------------------------------------------------------- logging
LOG_PATH=./data/app.log
LOG_LEVEL=info              # debug | info | warning | error
