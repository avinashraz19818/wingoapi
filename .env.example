# ==============================================================================
# WinGo API System - Environment Configuration
# Host Domain: api.devlopedwithzayro.site
# ==============================================================================

# Database Connection (MySQL / MariaDB on VPS)
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=club532583_in999
DB_USER=club532583_in999
DB_PASS=club532583_in999
DB_CHARSET=utf8mb4

# User Wallet Table (Compatible with in999 / TC Lottery script clones)
USER_TABLE=shonu_kaichila
USER_ID_COL=balakedara
USER_BAL_COL=motta

# Platform Fee & Commission (0.02 = 2%, 0.00 = 0%)
PLATFORM_FEE_RATE=0.02

# Server & Sync Settings
TIMEZONE=Asia/Kolkata
SYNC_INTERVAL_SECONDS=5
API_DOMAIN=api.devlopedwithzayro.site

# Result publication offset (how far the published result trails the clock).
#    0 = standard     : while round N is live, the newest result shown is N-1
#   -1 = 1 period back: while round N is live, the newest result shown is N-2
#   +1 = 1 period ahead
# Only publication is delayed - draws and payouts still run on the real clock.
ISSUE_OFFSET=-1
