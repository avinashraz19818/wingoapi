# ==============================================================================
# WinGo API System - Environment Configuration
# Host Domain: api.devlopedwithzayro.site
# ==============================================================================

# Database Connection (MySQL / MariaDB on VPS)
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=club532583_in999
DB_USER=club532583_in999
DB_PASS=club532583_in999
DB_CHARSET=utf8mb4

# User Wallet Table (Compatible with in999 / TC Lottery script clones)
USER_TABLE=shonu_kaichila
USER_ID_COL=balakedara
USER_BAL_COL=motta

# Platform Fee & Commission (0.02 = 2%, 0.00 = 0%)
PLATFORM_FEE_RATE=0.02

# Server & Sync Settings
TIMEZONE=Asia/Kolkata
SYNC_INTERVAL_SECONDS=2
API_DOMAIN=api.devlopedwithzayro.site

# ---------------------------------------------------------------------------
# Period Offset
#   0  = LIVE / exact (recommended). The period number served to the client is the
#        period the provider is drawing right now, so its result is available the
#        instant the countdown hits 00 -> no 5s delay in history / bet popup.
#  -1  = legacy behaviour, period number lags 1 period behind the provider.
#  +1  = 1 period ahead.
# ---------------------------------------------------------------------------
ISSUE_OFFSET=0

# ---------------------------------------------------------------------------
# Zero-delay "live pull"
# When a period has just closed and its result is not in the DB yet, the first client
# request pulls it from the provider immediately instead of waiting for the next cron tick.
# ---------------------------------------------------------------------------
LIVE_PULL_ENABLED=1
LIVE_PULL_MIN_GAP=0.8      # min seconds between two on-demand pulls for the same game
LIVE_PULL_WINDOW=10        # only auto-pull during the first N seconds of a new period
LIVE_PULL_MAX_WAIT=2.5     # max seconds a request waits for an in-flight pull

# Upstream HTTP timeouts (seconds). Keep them short - they run inside live requests.
UPSTREAM_TIMEOUT=3
UPSTREAM_CONNECT_TIMEOUT=2

# 1 = invent deterministic fake results when the provider is unreachable.
# FAKE numbers settle real bets, so leave this at 0 unless you really need it.
UPSTREAM_FALLBACK=0
